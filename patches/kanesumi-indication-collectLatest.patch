原来用 collect 串行 await 每个 animateTo，连点时动画排队，手指停下后还要挨个播完
（Arris 的迷你播放条上一首/暂停/下一首、分段控件都踩到）。改成 collectLatest：
新交互到达即取消上一条动画。
---
 .../takahashirinta/kanesumi/core/theme/MetroIndication.kt  | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/kanesumi-core/src/main/java/io/github/takahashirinta/kanesumi/core/theme/MetroIndication.kt b/kanesumi-core/src/main/java/io/github/takahashirinta/kanesumi/core/theme/MetroIndication.kt
index 1a1f3ed..57908a2 100644
--- a/kanesumi-core/src/main/java/io/github/takahashirinta/kanesumi/core/theme/MetroIndication.kt
+++ b/kanesumi-core/src/main/java/io/github/takahashirinta/kanesumi/core/theme/MetroIndication.kt
@@ -11,6 +11,7 @@ import androidx.compose.ui.graphics.Color
 import androidx.compose.ui.graphics.drawscope.ContentDrawScope
 import androidx.compose.ui.node.DelegatableNode
 import androidx.compose.ui.node.DrawModifierNode
+import kotlinx.coroutines.flow.collectLatest
 import kotlinx.coroutines.launch
 
 /**
@@ -63,7 +64,11 @@ private class MetroIndicationNode(
 
     override fun onAttach() {
         coroutineScope.launch {
-            interactionSource.interactions.collect { interaction ->
+            // collectLatest 而不是 collect：后者会**串行**await 每个 animateTo，
+            // 于是连点时按下/松手的动画排成一队，手指停下以后还要挨个播完
+            // （真机反馈的「连点之后反复闪」「暂停/上一首/下一首连点闪很多下」）。
+            // collectLatest 在新交互到达时取消上一条动画，永远只有最新的那次在播。
+            interactionSource.interactions.collectLatest { interaction ->
                 when (interaction) {
                     is PressInteraction.Press -> alpha.animateTo(
                         targetValue = 1f,
-- 
