<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- v1.6.0 · D3：Android 16 的实时更新（Live Updates）。真机实测权限名就是这个
         （不是文档里常见的 ..._ONGOING_NOTIFICATIONS）；只有 API 36+ 会用到，
         运行时还要 NotificationManager.canPostPromotedNotifications() 通过才发。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- 后台持续播放：请求系统把本应用加入电池优化白名单（"允许后台活动"）。
         不申请该权限时，ColorOS/MIUI 等 ROM 会在熄屏后杀掉前台播放服务。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 手机端扫码授权其他设备时用相机识别二维码（非必装硬件，故 required=false）。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".NcrustApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ncrust"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <!-- 允许 shell (Macrobenchmark/perfetto) 做方法级采样。不加这一行, release
             包的 trace 只有帧时序/Compose 段, 看不到具体函数热点。不影响运行性能。 -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <!-- Android Auto 媒体应用声明：声明本应用提供媒体浏览/播放。 -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Ncrust">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported=true: 车机 Media Center / 系统媒体控制需要跨进程绑定本服务。 -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- 兼容 legacy 媒体浏览器：Android Automotive 的 Media Center 通过
                     android.media.browse.MediaBrowserService 发现媒体应用。
                     media3 MediaSessionService.onBind 已处理该 action。 -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <!-- Android Automotive 的 media source opt-in：Media Center 的
                 MediaSource 只收录带此 meta-data 的“media template app”，
                 否则会以 "non media template app" 跳过。 -->
            <meta-data
                android:name="androidx.car.app.launchable"
                android:value="true" />
        </service>

        <!--
            v2.1.5 · 让系统把本应用识别为「媒体应用」（华为控件的 media white list 入口）。

            ## 真机实测的机制（华为 WGR-W09 / HarmonyOS 4.2 / EMUI 14.2.0 / Android 12）

            华为的 HwMediaSessionServiceInner 维护一份媒体应用白名单；不在其中的包会被打到：

                V HwMediaSessionServiceInner: this app is not in media white list,
                                             pkgName: com.takahashirinta.ncrust

            后果是控制中心的媒体卡对它显示「未在播放」。同一台设备上的 A/B 对照
            （三行分别是：应用 / 清单里是否声明 MEDIA_BUTTON / ROM 的 media_button_receiver
            注册表里在不在 / 控制中心卡片）：

                官方网易云     声明（MediaButtonEventReceiver，priority MAX）  在    正常显示歌名艺人
                华为音乐       声明（MediaButtonIntentReceiver）              在    正常显示
                Ncrust 修复前  未声明（清单里一个 receiver 都没有）             不在  未在播放

            对照证据（adb shell settings list global | grep media_button_receiver，实测原文）：

                media_button_receiver=com.netease.cloudmusic/MediaButtonEventReceiver,0,1
                ，com.huawei.music/MediaButtonIntentReceiver,0,1
                ，com.netease.cloudmusic/WebMediaButtonReceiver,0,1

            ## 为什么这是「正规声明」而不是「伪装」

            用 MediaSession / MediaSessionService 放音乐的应用本来就应该声明媒体按键接收器：
            这是平台把「谁是媒体应用」变成可发现事实的官方途径，也是 media3 文档的要求。
            没有它，会话未激活时媒体按键无处可去，系统也无从知道这个包会放音乐。
            本版补的就是这个声明，用 media3 自带的 MediaButtonReceiver，
            没有改包名、没有冒用别人的身份、没有蹭别家的会话标识。

            ## 它同时要修的问题

            补上之后 ROM 才有一个稳定的「本应用是媒体应用」判据。修复前实测到两条会话
            （legacy NcrustSession 与 media3 androidx.media3.session.id.）在 media button
            session 上反复互相顶替，日志形如：

                I MediaSessionService: Media button session is changed to .../androidx.media3.session.id.
                I MediaSessionService: Media button session is changed to .../NcrustSession
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
            v3.3.0 · 歌词分享 / 出图：把 cacheDir/share/ 下生成的海报以 content:// 交给接收方。

            ## 为什么必须是 FileProvider

            直接 `putExtra(EXTRA_STREAM, Uri.fromFile(f))` 在 API 24+ 会抛
            FileUriExposedException（本应用 minSdk 24，所以这条路从第一天起就是死的）；
            而写系统相册再分享则需要存储权限（API ≤ 28）。FileProvider 是唯一
            **零权限、全 API 可用**的图片分享路径。

            ## 三个属性都不能省

            · authorities = "${applicationId}.fileprovider" —— 与
              LyricShareActions 里 `"${context.packageName}.fileprovider"` 同源
              （packageName 就是 applicationId，debug 变体带后缀时两侧一起变）；
            · exported="false"：只有本应用能用它开 URI 权限（权限通过 Intent flag 临时授予）；
            · grantUriPermissions="true"：少了它，接收方打开 content:// 会
              SecurityException —— 症状是「分享出去是空白图」。

            路径白名单在同目录的 res/xml/file_paths.xml（只放开了 cache/share/）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            v3.3.0 · 桌面播放卡片（App Widget，用户需求第 4 条 = 第 8 条）。

            ## 为什么只声明一个 receiver

            尺寸适配走**运行时**：系统的 AppWidgetService 在每一次
            onUpdate / onAppWidgetOptionsChanged 里把 OPTION_APPWIDGET_MIN_WIDTH/HEIGHT
            交给 provider，由 WidgetSizeResolver 现场选布局。所以声明 5 个 provider
            去对应 5 种摆法既没必要、也做不到（用户把 4×1 拖成 2×2 时系统不会换 provider，
            只会改交给我们的尺寸）。五档/三档的取舍写在 WidgetSizeResolver 的 KDoc 里。

            ## exported="false" 是对的（不是漏写）

            APPWIDGET_UPDATE / OPTIONS_CHANGED 由**系统进程**（AppWidgetService，
            uid 1000）显式广播到本组件，系统不受 exported 限制；而 exported="true"
            会让任何应用都能给我们发 APPWIDGET_UPDATE —— 那只是白白多一个被骚扰的入口。
            （与 Android Studio 的 widget 模板一致。）

            ## meta-data 的 resource 指向 res/xml/ncrust_widget_info.xml

            那里才有 minWidth/minHeight（API 24~30）与 targetCellWidth/Height（API 31+）
            以及 resizeMode —— 卡片是几格、能不能拖、默认多大，全部在那一份里。

            ## 它同时是「本应用是媒体应用」的第二条正规声明

            与上面那条 MediaButtonReceiver 同源：桌面卡片让系统多一个「这个包会放音乐」的
            可发现事实，对华为那类维护 media white list 的 ROM 是正向的。
        -->
        <receiver
            android:name=".ui.widget.NcrustWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ncrust_widget_info" />
        </receiver>
    </application>
</manifest>