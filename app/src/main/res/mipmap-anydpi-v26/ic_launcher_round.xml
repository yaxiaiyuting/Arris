<?xml version="1.0" encoding="utf-8"?>
<!--
  Arris 自适应图标（API 26+）。
  ★ 比仓库原版多两处：
    · <monochrome>：Android 13+ 的「主题图标」，系统取 alpha 通道按壁纸着色。
      没有它，用户开着「主题图标」时看到的是一张系统给的灰底占位图。
    · 同款的 ic_launcher_round：API 25 会读 roundIcon。

  ⚠️ 本文件**只覆盖 API 26+**。API 24/25 靠 mipmap-*dpi/ic_launcher.png 回落 ——
     两者缺一不可（仓库此前只有本文件，于是 Android 7.0/7.1 上 launcher 拿不到图标，
     显示的是系统默认图标）。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
